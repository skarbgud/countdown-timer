# Multi-stage build for Render deployment
FROM node:18-alpine AS frontend-build

WORKDIR /app/frontend
COPY src/main/resources/static/frontend/package*.json ./
RUN npm ci --only=production

COPY src/main/resources/static/frontend/ ./
RUN npm run build

# Java build stage
FROM gradle:8.5-jdk17 AS java-build

WORKDIR /app
COPY . .
RUN gradle build -x test --no-daemon

# Final runtime stage
FROM openjdk:17-jre-slim

WORKDIR /app

# JVM 메모리 및 ZIP 처리 옵션 설정
ENV JAVA_OPTS="-Xmx512m -Xms256m -Djdk.util.zip.disableZip64ExtraFieldValidation=true"

# Copy the built JAR file (정확한 경로 확인)
COPY --from=java-build /app/build/libs/*.jar ./app.jar

# Copy frontend build files
COPY --from=frontend-build /app/frontend/build ./static

# Create logs directory
RUN mkdir -p /app/logs

# Expose port
EXPOSE 8080

# Run the application with memory and zip options
CMD ["sh", "-c", "java $JAVA_OPTS -jar app.jar --spring.profiles.active=prod"]