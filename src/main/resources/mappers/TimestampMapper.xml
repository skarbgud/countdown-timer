<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.timer.countdown.mapper.TimestampMapper">
    <resultMap id="timestampResultMap" type="com.timer.countdown.model.Timestamp">
        <id property="id" column="id"/>
        <result property="timerId" column="timer_id"/>
        <result property="capturedAt" column="captured_at"/>
        <result property="remainingTimeMs" column="remaining_time_ms"/>
        <result property="remainingTimeFormatted" column="remaining_time_formatted"/>
    </resultMap>
    
    <select id="selectNextTimestampId" resultType="long">
        SELECT timestamp_seq.NEXTVAL FROM DUAL
    </select>
    
    <insert id="insertTimestamp" parameterType="com.timer.countdown.model.Timestamp">
        INSERT INTO timestamps (id, timer_id, captured_at, remaining_time_ms, remaining_time_formatted)
        VALUES (#{id}, #{timerId}, #{capturedAt}, #{remainingTimeMs}, #{remainingTimeFormatted})
    </insert>
    
    <select id="selectTimestampsByTimerId" parameterType="string" resultMap="timestampResultMap">
        SELECT id, timer_id, captured_at, remaining_time_ms, remaining_time_formatted
        FROM timestamps
        WHERE timer_id = #{timerId}
        ORDER BY captured_at ASC
    </select>
</mapper>
