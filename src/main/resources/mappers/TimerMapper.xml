<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.timer.countdown.mapper.TimerMapper">
    <resultMap id="timerResultMap" type="com.timer.countdown.model.Timer">
        <id property="id" column="id"/>
        <result property="targetTime" column="target_time"/>
        <result property="ownerSessionId" column="owner_session_id"/>
        <collection property="timestamps" ofType="com.timer.countdown.model.Timestamp">
            <id property="id" column="timestamp_id"/>
            <result property="timerId" column="timer_id"/>
            <result property="capturedAt" column="captured_at"/>
            <result property="remainingTime" column="remaining_time"/>
        </collection>
    </resultMap>
    
    <insert id="insertTimer" parameterType="com.timer.countdown.model.Timer">
        INSERT INTO timer (id, target_time, owner_session_id)
        VALUES (#{id}, #{targetTime}, #{ownerSessionId})
    </insert>
    
    <select id="selectTimerById" parameterType="string" resultMap="timerResultMap">
        SELECT t.id, t.target_time, t.owner_session_id,
               ts.id as timestamp_id, ts.timer_id, ts.captured_at, ts.remaining_time
        FROM timer t
        LEFT JOIN timestamps ts ON t.id = ts.timer_id
        WHERE t.id = #{id}
    </select>
    
    <update id="updateTargetTime">
        UPDATE timer
        SET target_time = #{targetTime}
        WHERE id = #{id}
    </update>
</mapper>
